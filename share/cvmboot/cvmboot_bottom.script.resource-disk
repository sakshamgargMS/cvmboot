#!/bin/sh

# ATTN: preserve the following tag because cvmdisk checks for it:
# __resource_disk__

PREREQ=''

prereqs() {
  echo "$PREREQ"
}

case $1 in
prereqs)
  prereqs
  exit 0
  ;;
esac

script="root_ro script:"

# dev-mapper names:
# CAUTION: ${rootfs_ro} must match the same definition in verity.script
#rootfs_ro=rootfs_ro
#rootfs_rw=rootfs_rw
#rootfs=rootfs
rootfs_ro=rootfs_verity
rootfs_rw=rootfs_crypt

##==============================================================================
##
## cvmboot_panic(message)
##
##==============================================================================
cvmboot_panic()
{
    local message=$1
    echo "cvmboot_panic: ${message}"
    read
}

##==============================================================================
##
## create_rootfs_rw()
##
## Use dm-crypt to create the upper writable rootfs layer from the last
## partition.
##
## Resulting topology:
##
##     [ /dev/mapper/${rootfs_rw} ]
##     [ dm-crypt driver          ]
##     [ /dev/sda?                ]
##
##==============================================================================
create_rootfs_rw()
{
    # Find the OS disk by looking for our thin-data partition type GUID.
    # This GUID is unique to cvmboot-prepared disks.
    local thin_data_guid="136CE4AF-AFED-4F96-84FF-0651088074EE"
    local os_disk=""
    for candidate in /dev/sd?; do
        if [ -b "${candidate}" ]; then
            if fdisk -l -o DEVICE,Type-UUID "${candidate}" 2>/dev/null | grep -qi "${thin_data_guid}"; then
                os_disk="${candidate}"
                break
            fi
        fi
    done

    # The resource disk is whichever /dev/sd? is NOT the OS disk.
    local disk=""
    for candidate in /dev/sd?; do
        if [ -b "${candidate}" ] && [ "${candidate}" != "${os_disk}" ]; then
            disk="${candidate}"
            break
        fi
    done

    if [ -z "${disk}" ] || [ ! -b "${disk}" ]; then
        cvmboot_panic "${script}: resource disk not found (os_disk=${os_disk})"
    fi

    local partition="${disk}1"

    echo "${script}: os_disk=${os_disk} resource_disk=${disk}"

    # Remove partition if it exists
    if [ -b "${partition}" ]; then
        # Mount the resource disk partition:
        #mount.ntfs "${partition}" "${mountpoint}"
        #"$?" || cvmboot_panic "${script}: failed to mount: ${partition}"
        #
        #if [ ! -f "${mountpoint}/DATALOSS_WARNING_README.txt" ]; then
        #    cvmboot_panic "${script}: not a resource disk partition: ${partition}"
        #fi
        #
        #umount "${mountpoint}"
        #"$?" && cvmboot_panic "${script}: failed to unmount: ${partition}"

        parted -s "${disk}" rm 1
        if  [ "$?" != "0" ]; then
            cvmboot_panic "${script}: failed to remove partition: ${partition}"
        fi
    fi

    # Remove second partition if any
    if [ -b "${partition}" ]; then
        parted -s "${disk}" rm 1
        if  [ "$?" != "0" ]; then
            cvmboot_panic "${script}: failed to remove partition: ${partition}"
        fi
    fi

    # Create first NTFS partition
    parted -s "${disk}" mkpart primary ntfs "0%" "10%"
    if  [ "$?" != "0" ]; then
        cvmboot_panic "${script}: failed to create NTFS partition: ${disk}"
    fi

    # Create second NTFS partition
    parted -s "${disk}" mkpart primary ntfs "10%" "100%"
    if  [ "$?" != "0" ]; then
        cvmboot_panic "${script}: failed to create NTFS partition: ${disk}"
    fi

    # Determine the sector size of the second partition
    local sectsize=$(fdisk -l "${disk}" | grep "Units:" | awk '{print $8}')
    if  [ "$?" != "0" ]; then
        cvmboot_panic "cannot determine sector size"
    fi

    # Determine the starting sector of the second partition
    local start=$(fdisk -l "${disk}" | tail -n1 | awk '{print $2}')
    if  [ "$?" != "0" ]; then
        cvmboot_panic "cannot determine starting sector"
    fi

    # Determine the number of sectors (from the second partition)
    local sectors=$(fdisk -l "${disk}" | tail -n1 | awk '{print $4}')
    if  [ "$?" != "0" ]; then
        cvmboot_panic "cannot determine number of sectors"
    fi

    # Delete second NTFS partition
    parted -s "${disk}" rm 2
    if  [ "$?" != "0" ]; then
        cvmboot_panic "${script}: failed to delete the second NTFS partition"
    fi
    sleep 1

    # Format first NTFS partition
    sleep 1
    mkfs.ntfs -f "${partition}"
    if  [ "$?" != "0" ]; then
        cvmboot_panic "${script}: failed to format NTFS partition: ${partition}"
    fi

    # Create loop device for the image file:
    local offset=$((${start} * ${sectsize}))
    local size=$((${sectors} * ${sectsize}))
    local loop=$(losetup -o "${offset}" --sizelimit "${size}" -b "${sectsize}" -f "${disk}" --show)
    if  [ "$?" != "0" ]; then
        cvmboot_panic "${script}: failed to create loop device: ${filename}"
    fi

    # Generate the ephemeral key for dm-crypt
    local keyfile="/tmp/keyfile"
    local keysize=512
    dd if=/dev/urandom of=${keyfile} bs=${keysize} count=1
    if [ ! -f "${keyfile}" ]; then
        cvmboot_panic "${script}: failed to create ${keyfile}"
    fi

    echo "${script}: loop=${loop} offset=${offset} size=${size} sectors=${sectors} start=${start} sectsize=${sectsize}"

    # open the crypto device:
    cryptsetup open --type plain "${loop}" "${rootfs_rw}" --batch-mode --cipher=aes-xts-plain64 --key-size=${keysize} --key-file=${keyfile} --perf-no_write_workqueue
    if  [ "$?" != "0" ]; then
        cvmboot_panic "${script}: cannot open dm-crypt device: ${rootfs_rw}"
    fi

    echo "${script}: rootfs_rw blockdev=$(blockdev --getsz /dev/mapper/${rootfs_rw})"

    #echo "<<<<<<<< PRESS ANY KEY TO CONTINUE >>>>>>>>"
    #read
}

create_rootfs_rw

##==============================================================================
##
## Set up overlayfs root using:
##     lower = /dev/mapper/${rootfs_ro} (verity-protected, read-only)
##     upper = /dev/mapper/${rootfs_rw} (dm-crypt on resource disk, read-write)
##
## Resulting topology:
##
##                      [ overlayfs on ${rootmnt} ]
##                      /                         \
##      [ /run/cvmboot/lower (ro) ]    [ /run/cvmboot/upper (rw) ]
##      [ /dev/mapper/${rootfs_ro}]    [ /dev/mapper/${rootfs_rw}]
##      [ dm-verity driver        ]    [ dm-crypt driver         ]
##           /           \             [ loop on resource disk   ]
##          /             \
## [ thin volume (ext4) ] [ hash partition ]
##
##==============================================================================

# Format the crypt device as ext4 for the overlayfs upper layer
echo "${script}: formatting /dev/mapper/${rootfs_rw} as ext4"
mkfs.ext4 -q /dev/mapper/${rootfs_rw}
if [ "$?" != "0" ]; then
    cvmboot_panic "${script}: failed to format /dev/mapper/${rootfs_rw} as ext4"
fi

# Move the verity-protected root mount to /run/cvmboot/lower.
# Using /run/ ensures mounts survive switch_root.
mkdir -p /run/cvmboot/lower
mount -n -o move ${rootmnt} /run/cvmboot/lower
if [ "$?" != "0" ]; then
    cvmboot_panic "${script}: failed to move ${rootmnt} to /run/cvmboot/lower"
fi

# Mount the upper layer (encrypted resource disk)
mkdir -p /run/cvmboot/upper
mount /dev/mapper/${rootfs_rw} /run/cvmboot/upper
if [ "$?" != "0" ]; then
    cvmboot_panic "${script}: failed to mount /dev/mapper/${rootfs_rw}"
fi
mkdir -p /run/cvmboot/upper/upper /run/cvmboot/upper/work

# Load the overlay module explicitly
modprobe overlay 2>/dev/null

# Mount overlayfs as the new root
echo "${script}: mounting overlayfs on ${rootmnt}"
mount -t overlay overlay \
    -o lowerdir=/run/cvmboot/lower,upperdir=/run/cvmboot/upper/upper,workdir=/run/cvmboot/upper/work \
    ${rootmnt}
if [ "$?" != "0" ]; then
    cvmboot_panic "${script}: failed to mount overlayfs on ${rootmnt}"
fi

# Ensure correct permissions on the new root
chmod 755 "${rootmnt}"

echo "${script}: overlayfs mounted successfully"
